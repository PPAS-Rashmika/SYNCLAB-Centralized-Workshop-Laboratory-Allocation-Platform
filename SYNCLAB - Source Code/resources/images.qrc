<!DOCTYPE RCC>
<RCC version="1.0">
    <!-- Images වල සැබෑ folders මෙහි ඇත; alias නම් C++ සහ .ui files භාවිත කරයි. -->
    <!-- Program icon සහ welcome logo සඳහා resource කොටසයි. -->
    <qresource prefix="/branding">
        <!-- logo.png: tag එක ඇතුළේ file path වෙනස් කරයි; alias එකේ නම code references සමඟ ගළපන්න. -->
        <file alias="logo.png">logo/logo.png</file>
    </qresource>
    <!-- Workshops දහයේ pictures සඳහා resource කොටසයි. -->
    <qresource prefix="/workshops">
        <!-- Biochemistry.png: tag එක ඇතුළේ file path වෙනස් කරයි; alias එකේ නම code references සමඟ ගළපන්න. -->
        <file alias="Biochemistry.png">workshops and laboratory/Biochemistry.png</file>
        <!-- Electronics.png: tag එක ඇතුළේ file path වෙනස් කරයි; alias එකේ නම code references සමඟ ගළපන්න. -->
        <file alias="Electronics.png">workshops and laboratory/Electronics.png</file>
        <!-- Computer.png: tag එක ඇතුළේ file path වෙනස් කරයි; alias එකේ නම code references සමඟ ගළපන්න. -->
        <file alias="Computer.png">workshops and laboratory/Computer.png</file>
        <!-- Geotechnical.png: tag එක ඇතුළේ file path වෙනස් කරයි; alias එකේ නම code references සමඟ ගළපන්න. -->
