 <class>CustomAlertDialog</class>
 <widget class="QDialog" name="CustomAlertDialog">
  <property name="darkStyleSheet" stdset="0">
   <string notr="true">QWidget { font-family: "Segoe UI"; font-size: 10pt; }
QDialog { background-color: #172033; color: #F1F5F9; }
QLabel { color: #F1F5F9; background: transparent; }
QLineEdit, QComboBox { background-color: #0F172A; color: #F1F5F9; border: 1px solid #475569; border-radius: 7px; padding: 8px; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #2563EB; }
QComboBox QAbstractItemView { background-color: #0F172A; color: #F1F5F9; selection-background-color: #2563EB; selection-color: white; border: 1px solid #475569; }
QPushButton { background-color: #2563EB; color: white; border: 2px solid transparent; border-radius: 8px; padding: 2px 14px; }
QPushButton:focus, QPushButton:default { border-color: #F1F5F9; }
QPushButton:hover { border-color: #475569; }
QPushButton:disabled { background-color: #475569; color: #F1F5F9; }
QPushButton#cancelBtn, QPushButton#closeBtn { background-color: #0F172A; color: #F1F5F9; border-color: #475569; }
QGroupBox { color: #F1F5F9; border: 1px solid #475569; border-radius: 8px; margin-top: 16px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }
#CustomAlertDialog { font-family: "Segoe UI"; font-size: 10pt; }
#titleLbl { font-size: 16pt; font-weight: bold; }
#messageLbl { font-size: 12pt; }
#cancelBtn { font-size: 10pt; font-weight: bold; }
#okBtn { font-size: 10pt; font-weight: bold; }
QDialog[alertType="warning"] QPushButton#okBtn { background-color:#92400E; }
QDialog[alertType="error"] QPushButton#okBtn { background-color:#B91C1C; }</string>
