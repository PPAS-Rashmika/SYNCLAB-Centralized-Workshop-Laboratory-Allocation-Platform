   <string notr="true">QWidget { font-family: "Segoe UI"; font-size: 10pt; }
QWidget { color:#F1F5F9;   }
QMainWindow, QStackedWidget, QWidget#welcomeWidget, QWidget#selectionWidget, QWidget#calanderWidget, QWidget#formWidget, QWidget#adminWidget { background:#0F172A; }
QScrollArea { border:none; background:transparent; }
QScrollArea &gt; QWidget &gt; QWidget { background:#0F172A; }
QScrollArea#cardsScrollArea &gt; QWidget, QWidget#cardsScrollContents { background:transparent; }
