QLineEdit, QTextEdit, QComboBox { background:#1E293B; border:1px solid #43536B; border-radius:7px; padding:8px; selection-background-color:#2563EB; selection-color:white; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus { border:1px solid #2563EB; }
QComboBox QAbstractItemView { background:#1E293B; color:#F1F5F9; selection-background-color:#2563EB; selection-color:white; }
QPushButton { background:#1E293B; color:#F1F5F9; border:1px solid #43536B; border-radius:8px; padding:9px 14px;  }
QPushButton:hover, QPushButton:focus { background:#253C61; border-color:#2563EB; }
QPushButton:pressed { border:2px solid #2563EB; }
QPushButton#allocateNowBtn, QPushButton#nextBtn, QPushButton#nextTo3Btn, QPushButton#submitBtn, QPushButton#updateBtn { background:#2563EB; color:white; border:1px solid #2563EB; }
QPushButton#allocateNowBtn:hover, QPushButton#nextBtn:hover, QPushButton#nextTo3Btn:hover, QPushButton#submitBtn:hover, QPushButton#updateBtn:hover { background:#1D4ED8; }
QPushButton#deleteBtn, QPushButton#adminDelBtn { color:#FDA4AF; }
QPushButton[timeSlot=true] { padding:10px 8px; }
QPushButton:checked { background:#2563EB; color:white; border-color:#2563EB; }
QPushButton:disabled { background:#0F172A; color:#AABAD0; border:1px solid #43536B; }
QPushButton#allocateNowBtn:disabled, QPushButton#nextBtn:disabled, QPushButton#nextTo3Btn:disabled, QPushButton#submitBtn:disabled, QPushButton#updateBtn:disabled, QPushButton#deleteBtn:disabled, QPushButton#adminDelBtn:disabled { background:#0F172A; color:#AABAD0; border:1px solid #43536B; }
QFrame#summaryBox { background:#253C61; border:1px solid #43536B; border-radius:10px; }
QLabel#summaryDateLbl { color:#8DB8FF;  }
QTableWidget { background:#1E293B; alternate-background-color:#0F172A; border:1px solid #43536B; gridline-color:#43536B; selection-background-color:#253C61; selection-color:#F1F5F9; }
QHeaderView::section { font-weight:600; background:#253C61; color:#F1F5F9; border:none; padding:10px;  }
QTableWidget QLineEdit, QTableWidget QComboBox { padding:4px; border-radius:4px; }
QCalendarWidget { background:#1E293B; border:1px solid #43536B; border-radius:8px; }
QCalendarWidget QWidget#qt_calendar_navigationbar { background:#2563EB; }
