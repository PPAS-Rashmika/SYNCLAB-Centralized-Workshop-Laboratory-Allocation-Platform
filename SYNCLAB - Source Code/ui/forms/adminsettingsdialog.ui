 <!-- අනිවාර්ය admin emails දෙකේ dialog පෙනුමයි; validation code adminsettingsdialog.cpp හි ඇත. -->
 <class>AdminSettingsDialog</class>
 <!-- AdminSettingsDialog: කුඩා dialog කවුළුව; name එක C++ code එකේද භාවිත විය හැක. -->
 <widget class="QDialog" name="AdminSettingsDialog">
  <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>450</width>
    <height>348</height>
   </rect>
  </property>
  <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
  <property name="minimumSize">
   <size>
    <width>450</width>
    <height>348</height>
   </size>
  </property>
  <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
