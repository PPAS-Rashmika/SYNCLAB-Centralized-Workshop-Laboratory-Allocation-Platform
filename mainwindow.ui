<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1150</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Student Workshop App</string>
  </property>
  <property name="styleSheet">
   <string>#MainWindow { background-color: #F0F4FA; } QWidget#page1, QWidget#page2 { background: transparent; }</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout">
    <item>
     <widget class="QStackedWidget" name="stackedWidget">
      <property name="currentIndex">
       <number>0</number>
      </property>
      <property name="styleSheet">
       <string>background: transparent;</string>
      </property>
      <widget class="QWidget" name="page1">
       <layout class="QVBoxLayout" name="verticalLayout_2">
        <property name="leftMargin"><number>20</number></property>
        <property name="topMargin"><number>30</number></property>
        <property name="rightMargin"><number>20</number></property>
        <property name="bottomMargin"><number>20</number></property>
        
        <!-- Logo Label Added Here -->
        <item>
         <widget class="QLabel" name="logoLabel">
          <property name="text"><string></string></property>
          <property name="alignment"><set>Qt::AlignCenter</set></property>
         </widget>
        </item>
        
        <item>
         <widget class="QLabel" name="headerLabel">
          <property name="text"><string>WORKSHOPS &amp; LABORATORIES</string></property>
          <property name="alignment"><set>Qt::AlignCenter</set></property>
          <property name="styleSheet"><string>font-size: 28px; font-weight: 800; color: #112A46; font-family: 'Segoe UI', Arial; letter-spacing: 1px; margin-top: 10px;</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="subHeaderLabel">
          <property name="text"><string>Select a workshop below to explore its facilities, manage student bookings, and view technical details.</string></property>
          <property name="alignment"><set>Qt::AlignCenter</set></property>
          <property name="styleSheet"><string>font-size: 14px; color: #5B6A7A; margin-bottom: 20px;</string></property>
         </widget>
        </item>
        <item>
         <layout class="QGridLayout" name="gridLayout">
          <property name="spacing"><number>25</number></property>
         </layout>
        </item>
        <item>
         <spacer name="verticalSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
         </spacer>
        </item>
       </layout>
      </widget>
      
      <widget class="QWidget" name="page2">
       <layout class="QGridLayout" name="gridLayout_2">
        <property name="horizontalSpacing"><number>20</number></property>
        <property name="verticalSpacing"><number>20</number></property>
        <property name="leftMargin"><number>20</number></property>
        <property name="topMargin"><number>20</number></property>
        <property name="rightMargin"><number>20</number></property>
        <property name="bottomMargin"><number>20</number></property>
        
        <item row="0" column="0" alignment="Qt::AlignTop">
         <layout class="QHBoxLayout" name="horizontalLayout">
          <item alignment="Qt::AlignTop">
           <widget class="QPushButton" name="backBtn">
            <property name="text"><string>&lt;- Back to 1st Interface</string></property>
            <property name="styleSheet"><string>padding: 10px 15px; background-color: #E2E8F0; color: #334155; border-radius: 5px; font-weight: bold;</string></property>
           </widget>
          </item>
          <item alignment="Qt::AlignTop">
           <widget class="QPushButton" name="viewRecordsBtn">
            <property name="text"><string>VIEW ALL BOOKINGS</string></property>
            <property name="styleSheet"><string>padding: 10px 15px; background-color: #0284C7; color: white; border-radius: 5px; font-weight: bold;</string></property>
           </widget>
          </item>
          <item>
           <spacer name="horizontalSpacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
           </spacer>
          </item>
         </layout>
        </item>
        
        <item row="0" column="1">
         <widget class="QCalendarWidget" name="calendar">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="styleSheet"><string>QCalendarWidget QWidget { alternate-background-color: #F1F5F9; }</string></property>
         </widget>
        </item>
        
        <item row="1" column="0" colspan="2">
         <widget class="QLabel" name="formHeader">
          <property name="text"><string>STUDENT INFORMATION</string></property>
          <property name="alignment"><set>Qt::AlignCenter</set></property>
          <property name="styleSheet"><string>font-size: 16px; font-weight: bold; color: #0F172A; margin-top: 10px; margin-bottom: 10px; text-transform: uppercase;</string></property>
         </widget>
        </item>
        
        <item row="2" column="0">
         <layout class="QVBoxLayout" name="leftForm">
          <item><widget class="QLabel" name="label"><property name="text"><string>NAME</string></property></widget></item>
          <item><widget class="QLineEdit" name="nameInput"><property name="placeholderText"><string>Enter student name</string></property><property name="styleSheet"><string>padding: 8px; border: 1px solid #CBD5E1; border-radius: 4px; background-color: white;</string></property></widget></item>
          <item><widget class="QLabel" name="label_2"><property name="text"><string>INDEX</string></property></widget></item>
          <item><widget class="QLineEdit" name="indexInput"><property name="placeholderText"><string>Enter index number</string></property><property name="styleSheet"><string>padding: 8px; border: 1px solid #CBD5E1; border-radius: 4px; background-color: white;</string></property></widget></item>
          <item><widget class="QLabel" name="label_3"><property name="text"><string>DEPARTMENT</string></property></widget></item>
          <item>
           <widget class="QComboBox" name="deptInput">
            <property name="styleSheet"><string>padding: 8px; border: 1px solid #CBD5E1; border-radius: 4px; background-color: white;</string></property>
            <item><property name="text"><string>Select department</string></property></item>
            <item><property name="text"><string>Computer Science</string></property></item>
            <item><property name="text"><string>Engineering</string></property></item>
            <item><property name="text"><string>Technology</string></property></item>
           </widget>
          </item>
          <item><widget class="QLabel" name="label_email"><property name="text"><string>EMAIL ADDRESS</string></property></widget></item>
          <item><widget class="QLineEdit" name="emailInput"><property name="placeholderText"><string>Enter email address</string></property><property name="styleSheet"><string>padding: 8px; border: 1px solid #CBD5E1; border-radius: 4px; background-color: white;</string></property></widget></item>
          <item><widget class="QLabel" name="label_pdf"><property name="text"><string>ATTACH PDF DOCUMENT</string></property></widget></item>
          <item>
           <layout class="QHBoxLayout" name="pdfLayout">
            <item><widget class="QLineEdit" name="pdfInput"><property name="placeholderText"><string>Select PDF file...</string></property><property name="readOnly"><bool>true</bool></property><property name="styleSheet"><string>padding: 8px; border: 1px solid #CBD5E1; border-radius: 4px; background-color: white;</string></property></widget></item>
            <item><widget class="QPushButton" name="browsePdfBtn"><property name="text"><string>BROWSE</string></property><property name="styleSheet"><string>padding: 8px 15px; background-color: #64748B; color: white; border-radius: 4px; font-weight: bold;</string></property></widget></item>
           </layout>
          </item>
          <item><widget class="QLabel" name="label_4"><property name="text"><string>DATE</string></property></widget></item>
          <item>
           <widget class="QDateEdit" name="dateInput">
            <property name="calendarPopup"><bool>true</bool></property>
            <property name="displayFormat"><string>yyyy-MM-dd</string></property>
            <property name="styleSheet"><string>padding: 8px; border: 1px solid #CBD5E1; border-radius: 4px; background-color: white;</string></property>
           </widget>
          </item>
          <item><widget class="QLabel" name="label_5"><property name="text"><string>TIME SLOTS</string></property></widget></item>
          <item><widget class="QComboBox" name="timeSlotInput"><property name="styleSheet"><string>padding: 8px; border: 1px solid #CBD5E1; border-radius: 4px; background-color: white;</string></property></widget></item>
         </layout>
        </item>
        
        <item row="2" column="1">
         <layout class="QVBoxLayout" name="rightForm">
          <item><widget class="QLabel" name="label_6"><property name="text"><string>DESCRIPTION</string></property></widget></item>
          <item>
           <widget class="QTextEdit" name="descriptionInput">
            <property name="placeholderText"><string>Enter description</string></property>
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="styleSheet"><string>border: 1px solid #CBD5E1; border-radius: 4px; padding: 5px; background-color: white;</string></property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="actionButtonsLayout">
            <item>
             <widget class="QPushButton" name="submitBtn">
              <property name="text"><string>SUBMIT</string></property>
              <property name="styleSheet"><string>background-color: #2563EB; color: white; padding: 15px; border-radius: 5px; font-weight: bold;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="updateBtn">
              <property name="text"><string>UPDATE</string></property>
              <property name="styleSheet"><string>background-color: #D97706; color: white; padding: 15px; border-radius: 5px; font-weight: bold;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="deleteBtn">
              <property name="text"><string>DELETE</string></property>
              <property name="styleSheet"><string>background-color: #DC2626; color: white; padding: 15px; border-radius: 5px; font-weight: bold;</string></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
 </widget>
