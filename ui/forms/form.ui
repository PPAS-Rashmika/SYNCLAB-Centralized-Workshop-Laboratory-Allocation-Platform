<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <!-- Student booking form එකයි; labels, input geometry සහ department list මෙහි වෙනස් කරන්න. -->
 <class>formWidget</class>
 <!-- formWidget: ඇතුළත controls තබන කොටස; name එක C++ code එකේද භාවිත විය හැක. -->
 <widget class="QWidget" name="formWidget">
  <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1180</width>
    <height>780</height>
   </rect>
  </property>
  <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
  <property name="font">
   <font>
    <family>Segoe UI</family>
    <pointsize>10</pointsize>
    <bold>false</bold>
   </font>
  </property>
  <!-- මෙම control එකේ පාට, border, padding සහ radius සඳහා CSS rules මෙහි ඇත. -->
  <property name="styleSheet">
   <string notr="true">QWidget { color:#17243B;   }QMainWindow, QStackedWidget, QWidget#welcomeWidget, QWidget#selectionWidget, QWidget#calanderWidget, QWidget#formWidget, QWidget#adminWidget { background:#F4F7FB; }QScrollArea { border:none; background:transparent; } QScrollArea &gt; QWidget &gt; QWidget { background:#F4F7FB; }QScrollArea#cardsScrollArea &gt; QWidget, QWidget#cardsScrollContents { background:transparent; }QLabel { background:transparent; }QLabel#welcomeTitle { color:#52647D;   }QLabel#syncLabTitle {   }QLabel#syncLabSubtitle {   }QLabel#welcomeDesc, QLabel#selectedDescLabel2, QLabel#adminWsDescLbl { color:#52647D;  }QLabel#selectTitleLabel, QLabel#selectedNameLabel2, QLabel#confirmTitleLbl, QLabel#adminWsTitleLbl {   }QLineEdit, QTextEdit, QComboBox { background:#FFFFFF; border:1px solid #D4DEEB; border-radius:7px; padding:8px; selection-background-color:#2563EB; selection-color:white; }QLineEdit:focus, QTextEdit:focus, QComboBox:focus { border:1px solid #2563EB; }QComboBox QAbstractItemView { background:#FFFFFF; color:#17243B; selection-background-color:#2563EB; selection-color:white; }QPushButton { background:#FFFFFF; color:#17243B; border:1px solid #D4DEEB; border-radius:8px; padding:9px 14px;  }QPushButton:hover, QPushButton:focus { background:#EAF2FF; border-color:#2563EB; }QPushButton:pressed { border:2px solid #2563EB; }QPushButton#allocateNowBtn, QPushButton#nextBtn, QPushButton#nextTo3Btn, QPushButton#submitBtn, QPushButton#updateBtn { background:#2563EB; color:white; border:1px solid #2563EB; }QPushButton#allocateNowBtn:hover, QPushButton#nextBtn:hover, QPushButton#nextTo3Btn:hover, QPushButton#submitBtn:hover, QPushButton#updateBtn:hover { background:#1D4ED8; }QPushButton#deleteBtn, QPushButton#adminDelBtn { color:#BE123C; }QPushButton[timeSlot=true] { padding:10px 8px; }QPushButton:checked { background:#2563EB; color:white; border-color:#2563EB; }QPushButton:disabled { background:#F4F7FB; color:#52647D; border:1px solid #D4DEEB; }QPushButton#allocateNowBtn:disabled, QPushButton#nextBtn:disabled, QPushButton#nextTo3Btn:disabled, QPushButton#submitBtn:disabled, QPushButton#updateBtn:disabled, QPushButton#deleteBtn:disabled, QPushButton#adminDelBtn:disabled { background:#F4F7FB; color:#52647D; border:1px solid #D4DEEB; }QFrame#summaryBox { background:#EAF2FF; border:1px solid #D4DEEB; border-radius:10px; }QLabel#summaryDateLbl { color:#2563EB;  }QTableWidget { background:#FFFFFF; alternate-background-color:#F4F7FB; border:1px solid #D4DEEB; gridline-color:#D4DEEB; selection-background-color:#EAF2FF; selection-color:#17243B; }QHeaderView::section { font-weight:600; background:#EAF2FF; color:#17243B; border:none; padding:10px;  }QTableWidget QLineEdit, QTableWidget QComboBox { padding:4px; border-radius:4px; }QCalendarWidget { background:#FFFFFF; border:1px solid #D4DEEB; border-radius:8px; }QCalendarWidget QWidget#qt_calendar_navigationbar { background:#2563EB; }QCalendarWidget QToolButton { font-weight:600; color:white; background:transparent; padding:6px;  }QCalendarWidget QMenu, QCalendarWidget QSpinBox { background:#FFFFFF; color:#17243B; }QCalendarWidget QAbstractItemView { background:#FFFFFF; color:#17243B; selection-background-color:#2563EB; selection-color:white; outline:0; }QToolTip { background:#FFFFFF; color:#17243B; border:1px solid #D4DEEB; padding:6px; }</string>
  </property>
  <!-- backTo2Btn: ක්ලික් කළ හැකි button එක; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QPushButton" name="backTo2Btn">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>24</y>
     <width>171</width>
     <height>37</height>
    </rect>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <family>Segoe UI</family>
     <pointsize>10</pointsize>
     <bold>true</bold>
    </font>
   </property>
   <property name="cursor">
    <cursorShape>PointingHandCursor</cursorShape>
   </property>
   <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
   <property name="text">
    <string>Back to Time Slot</string>
   </property>
  </widget>
  <!-- confirmTitleLbl: text/image පෙන්වන label එක; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QLabel" name="confirmTitleLbl">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>77</y>
     <width>1132</width>
     <height>33</height>
    </rect>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <family>Segoe UI</family>
     <pointsize>19</pointsize>
     <bold>true</bold>
    </font>
   </property>
   <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
   <property name="text">
    <string>Finalize your allocation</string>
   </property>
   <property name="textFormat">
    <enum>Qt::TextFormat::PlainText</enum>
   </property>
  </widget>
  <!-- summaryBox: card හෝ border සහිත කොටස; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QFrame" name="summaryBox">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>126</y>
     <width>1132</width>
     <height>72</height>
    </rect>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <family>Segoe UI</family>
     <pointsize>10</pointsize>
     <bold>false</bold>
    </font>
   </property>
   <!-- summaryDateLbl: text/image පෙන්වන label එක; name එක C++ code එකේද භාවිත විය හැක. -->
   <widget class="QLabel" name="summaryDateLbl">
    <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
    <property name="geometry">
     <rect>
      <x>21</x>
      <y>16</y>
      <width>1090</width>
      <height>17</height>
     </rect>
    </property>
    <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
    <property name="font">
     <font>
      <family>Segoe UI</family>
      <pointsize>10</pointsize>
      <bold>true</bold>
     </font>
    </property>
    <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
    <property name="text">
     <string>Date: </string>
    </property>
    <property name="textFormat">
     <enum>Qt::TextFormat::PlainText</enum>
    </property>
    <!-- true නම් ඉඩ මදි text එක ඊළඟ පේළියට යයි. -->
    <property name="wordWrap">
     <bool>true</bool>
    </property>
   </widget>
   <!-- summaryTimeLbl: text/image පෙන්වන label එක; name එක C++ code එකේද භාවිත විය හැක. -->
   <widget class="QLabel" name="summaryTimeLbl">
    <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
    <property name="geometry">
     <rect>
      <x>21</x>
      <y>39</y>
      <width>1090</width>
      <height>17</height>
     </rect>
    </property>
    <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
    <property name="font">
     <font>
      <family>Segoe UI</family>
      <pointsize>10</pointsize>
      <bold>false</bold>
     </font>
    </property>
    <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
    <property name="text">
     <string>Time: </string>
    </property>
    <property name="textFormat">
     <enum>Qt::TextFormat::PlainText</enum>
    </property>
    <!-- true නම් ඉඩ මදි text එක ඊළඟ පේළියට යයි. -->
    <property name="wordWrap">
     <bool>true</bool>
    </property>
   </widget>
  </widget>
  <!-- formScrollArea: ඉඩ මදි විට scroll කරන කොටස; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QScrollArea" name="formScrollArea">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>214</y>
     <width>1132</width>
     <height>476</height>
    </rect>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <family>Segoe UI</family>
     <pointsize>10</pointsize>
     <bold>false</bold>
    </font>
   </property>
   <property name="frameShape">
    <enum>QFrame::Shape::NoFrame</enum>
   </property>
   <property name="widgetResizable">
    <bool>false</bool>
   </property>
   <!-- formScrollContents: ඇතුළත controls තබන කොටස; name එක C++ code එකේද භාවිත විය හැක. -->
   <widget class="QWidget" name="formScrollContents">
    <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
    <property name="geometry">
     <rect>
      <x>0</x>
      <y>0</y>
      <width>1132</width>
      <height>476</height>
     </rect>
    </property>
    <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
    <property name="minimumSize">
     <size>
      <width>1132</width>
      <height>476</height>
     </size>
    </property>
    <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
    <property name="font">
     <font>
      <family>Segoe UI</family>
      <pointsize>10</pointsize>
      <bold>false</bold>
     </font>
    </property>
    <!-- label: text/image පෙන්වන label එක; name එක C++ code එකේද භාවිත විය හැක. -->
    <widget class="QLabel" name="label">
     <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
     <property name="geometry">
      <rect>
       <x>9</x>
       <y>9</y>
       <width>545</width>
       <height>21</height>
      </rect>
     </property>
     <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
     <property name="font">
      <font>
       <family>Segoe UI</family>
       <pointsize>10</pointsize>
       <bold>false</bold>
      </font>
     </property>
     <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
     <property name="text">
      <string>Full name *</string>
     </property>
     <property name="textFormat">
      <enum>Qt::TextFormat::PlainText</enum>
     </property>
     <property name="buddy">
      <cstring>nameInput</cstring>
     </property>
    </widget>
    <!-- nameInput: එක් පේළියක text input එක; name එක C++ code එකේද භාවිත විය හැක. -->
    <widget class="QLineEdit" name="nameInput">
     <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
     <property name="geometry">
      <rect>
       <x>9</x>
       <y>40</y>
       <width>545</width>
       <height>37</height>
      </rect>
     </property>
     <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
     <property name="font">
      <font>
       <family>Segoe UI</family>
       <pointsize>10</pointsize>
       <bold>false</bold>
      </font>
     </property>
     <property name="maxLength">
      <number>254</number>
     </property>
     <!-- Input එක හිස් විට පෙන්වන උදව් text එක මෙහි වෙනස් කරන්න. -->
     <property name="placeholderText">
      <string>Enter your full name</string>
     </property>
     <property name="clearButtonEnabled">
      <bool>true</bool>
     </property>
    </widget>
    <!-- label_2: text/image පෙන්වන label එක; name එක C++ code එකේද භාවිත විය හැක. -->
    <widget class="QLabel" name="label_2">
     <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
     <property name="geometry">
      <rect>
       <x>9</x>
       <y>87</y>
       <width>545</width>
       <height>21</height>
      </rect>
