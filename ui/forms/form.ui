     <property name="text">
      <string>Description (optional)</string>
     </property>
     <property name="textFormat">
      <enum>Qt::TextFormat::PlainText</enum>
     </property>
     <property name="buddy">
      <cstring>descriptionInput</cstring>
     </property>
    </widget>
    <!-- descriptionInput: පේළි කිහිපයක text input එක; name එක C++ code එකේද භාවිත විය හැක. -->
