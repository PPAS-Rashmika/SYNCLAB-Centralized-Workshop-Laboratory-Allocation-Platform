  <property name="styleSheet">
   <string notr="true">QDialog { background-color: #FFFFFF; color: #0F172A; }
QLabel { color: #0F172A; background: transparent; }
QLineEdit, QComboBox { background-color: #F8FAFC; color: #0F172A; border: 1px solid #CBD5E1; border-radius: 7px; padding: 8px; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #2563EB; }
QComboBox QAbstractItemView { background-color: #F8FAFC; color: #0F172A; selection-background-color: #2563EB; selection-color: white; border: 1px solid #CBD5E1; }
QPushButton { background-color: #2563EB; color: white; border: 2px solid transparent; border-radius: 8px; padding: 2px 14px; }
QPushButton:focus, QPushButton:default { border-color: #0F172A; }
QPushButton:hover { border-color: #CBD5E1; }
QPushButton:disabled { background-color: #CBD5E1; color: #0F172A; }
QPushButton#cancelBtn, QPushButton#closeBtn { background-color: #F8FAFC; color: #0F172A; border-color: #CBD5E1; }
QGroupBox { color: #0F172A; border: 1px solid #CBD5E1; border-radius: 8px; margin-top: 16px; padding-top: 10px; }
