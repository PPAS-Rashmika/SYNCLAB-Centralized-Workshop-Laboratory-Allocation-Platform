<?xml version='1.0' encoding='utf-8'?>
<ui version="4.0">
 <!-- Theme, wallpaper සහ passcodes settings dialog එකේ පෙනුමයි. -->
 <class>SystemSettingsDialog</class>
 <!-- SystemSettingsDialog: කුඩා dialog කවුළුව; name එක C++ code එකේද භාවිත විය හැක. -->
 <widget class="QDialog" name="SystemSettingsDialog">
  <property name="windowTitle">
   <string>System settings</string>
  </property>
  <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>540</height>
   </rect>
  </property>
  <!-- titleLbl: text/image පෙන්වන label එක; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QLabel" name="titleLbl">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>24</y>
     <width>512</width>
     <height>34</height>
    </rect>
   </property>
   <!-- true නම් ඉඩ මදි text එක ඊළඟ පේළියට යයි. -->
   <property name="wordWrap">
    <bool>true</bool>
   </property>
   <property name="textFormat">
    <enum>Qt::PlainText</enum>
   </property>
   <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
   <property name="text">
    <string>System Settings</string>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <pointsize>16</pointsize>
     <bold>true</bold>
    </font>
   </property>
   <property name="alignment">
    <set>Qt::AlignCenter</set>
   </property>
  </widget>
  <!-- toggleThemeBtn: ක්ලික් කළ හැකි button එක; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QPushButton" name="toggleThemeBtn">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>80</y>
     <width>512</width>
     <height>46</height>
    </rect>
   </property>
   <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
   <property name="minimumSize">
    <size>
     <width>0</width>
     <height>45</height>
    </size>
   </property>
   <property name="cursor">
    <cursorShape>PointingHandCursor</cursorShape>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <pointsize>10</pointsize>
     <bold>true</bold>
    </font>
   </property>
   <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
   <property name="text">
    <string>Switch to dark mode</string>
   </property>
  </widget>
  <!-- changeWallpaperBtn: ක්ලික් කළ හැකි button එක; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QPushButton" name="changeWallpaperBtn">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>138</y>
     <width>512</width>
     <height>46</height>
    </rect>
   </property>
   <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
   <property name="text">
    <string>Change Background Wallpaper</string>
   </property>
   <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
   <property name="minimumSize">
    <size>
     <width>0</width>
     <height>45</height>
    </size>
   </property>
   <property name="cursor">
    <cursorShape>PointingHandCursor</cursorShape>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <pointsize>10</pointsize>
     <bold>true</bold>
    </font>
   </property>
  </widget>
  <!-- groupBox: UI control එක; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QGroupBox" name="groupBox">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>196</y>
     <width>512</width>
     <height>208</height>
    </rect>
   </property>
   <property name="title">
    <string>Administrator passcodes</string>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <bold>true</bold>
    </font>
   </property>
   <!-- lblCat: text/image පෙන්වන label එක; name එක C++ code එකේද භාවිත විය හැක. -->
   <widget class="QLabel" name="lblCat">
    <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
    <property name="geometry">
     <rect>
      <x>12</x>
      <y>39</y>
      <width>138</width>
      <height>38</height>
     </rect>
    </property>
    <!-- true නම් ඉඩ මදි text එක ඊළඟ පේළියට යයි. -->
    <property name="wordWrap">
     <bool>true</bool>
    </property>
    <property name="textFormat">
     <enum>Qt::PlainText</enum>
    </property>
    <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
    <property name="text">
     <string>&amp;Administrator</string>
    </property>
   </widget>
   <!-- workshopCombo: ලැයිස්තුවෙන් අගයක් තෝරන control එක; name එක C++ code එකේද භාවිත විය හැක. -->
   <widget class="QComboBox" name="workshopCombo">
    <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
    <property name="geometry">
     <rect>
      <x>160</x>
      <y>39</y>
      <width>340</width>
      <height>38</height>
     </rect>
    </property>
    <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
    <property name="minimumSize">
     <size>
      <width>0</width>
      <height>35</height>
     </size>
    </property>
    <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
    <property name="font">
     <font>
      <pointsize>10</pointsize>
     </font>
    </property>
   </widget>
   <!-- lblCode: text/image පෙන්වන label එක; name එක C++ code එකේද භාවිත විය හැක. -->
   <widget class="QLabel" name="lblCode">
    <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
    <property name="geometry">
     <rect>
      <x>12</x>
      <y>89</y>
      <width>138</width>
      <height>38</height>
     </rect>
    </property>
    <!-- true නම් ඉඩ මදි text එක ඊළඟ පේළියට යයි. -->
    <property name="wordWrap">
     <bool>true</bool>
    </property>
    <property name="textFormat">
     <enum>Qt::PlainText</enum>
    </property>
    <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
    <property name="text">
     <string>&amp;New passcode</string>
    </property>
   </widget>
   <!-- newPasscodeInput: එක් පේළියක text input එක; name එක C++ code එකේද භාවිත විය හැක. -->
   <widget class="QLineEdit" name="newPasscodeInput">
    <!-- Input එක හිස් විට පෙන්වන උදව් text එක මෙහි වෙනස් කරන්න. -->
    <property name="placeholderText">
     <string>At least 4 characters</string>
    </property>
    <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
    <property name="geometry">
     <rect>
      <x>160</x>
      <y>89</y>
      <width>340</width>
      <height>38</height>
     </rect>
    </property>
    <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
    <property name="minimumSize">
     <size>
      <width>0</width>
      <height>35</height>
     </size>
    </property>
    <!-- Password නම් input අකුරු සැඟවෙයි; Normal නම් පෙන්වයි. -->
    <property name="echoMode">
     <enum>QLineEdit::Password</enum>
    </property>
    <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
    <property name="font">
     <font>
      <pointsize>10</pointsize>
     </font>
    </property>
   </widget>
   <!-- savePasscodeBtn: ක්ලික් කළ හැකි button එක; name එක C++ code එකේද භාවිත විය හැක. -->
   <widget class="QPushButton" name="savePasscodeBtn">
    <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
    <property name="geometry">
     <rect>
      <x>12</x>
      <y>145</y>
      <width>488</width>
      <height>46</height>
     </rect>
    </property>
    <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
    <property name="text">
     <string>Update Passcode</string>
    </property>
    <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
    <property name="minimumSize">
     <size>
      <width>0</width>
      <height>40</height>
     </size>
    </property>
    <property name="cursor">
     <cursorShape>PointingHandCursor</cursorShape>
    </property>
    <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
    <property name="font">
     <font>
      <pointsize>10</pointsize>
      <bold>true</bold>
     </font>
    </property>
   </widget>
  </widget>
  <!-- closeBtn: ක්ලික් කළ හැකි button එක; name එක C++ code එකේද භාවිත විය හැක. -->
  <widget class="QPushButton" name="closeBtn">
   <!-- ස්ථානය x/y වලින්ද ප්‍රමාණය width/height වලින්ද වෙනස් කරන්න. -->
   <property name="geometry">
    <rect>
     <x>24</x>
     <y>470</y>
     <width>512</width>
     <height>46</height>
    </rect>
   </property>
   <!-- පෙන්වන text එක මෙහි වෙනස් කරන්න; dynamic text C++ මගින් නැවත යෙදිය හැක. -->
   <property name="text">
    <string>Close</string>
   </property>
   <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
   <property name="minimumSize">
    <size>
     <width>0</width>
     <height>45</height>
    </size>
   </property>
   <property name="cursor">
    <cursorShape>PointingHandCursor</cursorShape>
   </property>
   <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
   <property name="font">
    <font>
     <pointsize>10</pointsize>
     <bold>true</bold>
    </font>
   </property>
  </widget>
  <!-- මෙම control එකේ පාට, border, padding සහ radius සඳහා CSS rules මෙහි ඇත. -->
  <property name="styleSheet">
   <string notr="true">QDialog { background-color: #FFFFFF; color: #0F172A; }
QLabel { color: #0F172A; background: transparent; }
QLineEdit, QComboBox { background-color: #F8FAFC; color: #0F172A; border: 1px solid #CBD5E1; border-radius: 7px; padding: 8px; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #2563EB; }
QComboBox QAbstractItemView { background-color: #F8FAFC; color: #0F172A; selection-background-color: #2563EB; selection-color: white; border: 1px solid #CBD5E1; }
QPushButton { background-color: #2563EB; color: white; border: 2px solid transparent; border-radius: 8px; padding: 2px 14px; }
QPushButton:focus, QPushButton:default { border-color: #0F172A; }
QPushButton:hover { border-color: #CBD5E1; }
QPushButton:disabled { background-color: #CBD5E1; color: #0F172A; }
QPushButton#cancelBtn, QPushButton#closeBtn { background-color: #F8FAFC; color: #0F172A; border-color: #CBD5E1; }
QGroupBox { color: #0F172A; border: 1px solid #CBD5E1; border-radius: 8px; margin-top: 16px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }</string>
  </property>
  <!-- මෙම control එකේ font නම, size සහ bold බව මෙහි වෙනස් කරන්න. -->
  <property name="font">
   <font>
    <family>Segoe UI</family>
    <pointsize>10</pointsize>
   </font>
  </property>
  <!-- Control එක මෙයට වඩා කුඩා කිරීමට ඉඩ නොදෙන ප්‍රමාණයයි. -->
  <property name="minimumSize">
   <size>
    <width>560</width>
    <height>540</height>
   </size>
  </property>
 </widget>
 <!-- Tab key මගින් controls අතර යන අනුපිළිවෙළ මෙහි ඇත. -->
 <tabstops>
  <tabstop>toggleThemeBtn</tabstop>
  <tabstop>changeWallpaperBtn</tabstop>
  <tabstop>workshopCombo</tabstop>
  <tabstop>newPasscodeInput</tabstop>
  <tabstop>savePasscodeBtn</tabstop>
  <tabstop>closeBtn</tabstop>
 </tabstops>
</ui>
